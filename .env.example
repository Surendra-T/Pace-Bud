# Pace-Bud Environment Configuration

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.tqkerr0.mongodb.net/pacebud?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=pacebud

# Local Ollama Gemma LLM (Overrides DO)
DIGITALOCEAN_GEMMA_ENDPOINT=http://127.0.0.1:11434/v1
DIGITALOCEAN_API_KEY=ollama
GEMMA_MODEL=gemma2:9b

# ElevenLabs Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Temporal 
USE_TEMPORAL=false
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=pacebud-field-logs

# Server & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000

# Geolocation Defaults (Bengaluru)
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946

# Demo User Identity
DEMO_USER_ID=john-wick
DEMO_USER_NAME="John Wick"

# Spotify Integration 
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback
VITE_SPOTIFY_DEFAULT_PLAYLIST=https://open.spotify.com/playlist/37i9dQZF1DXdLEN7aqioXM